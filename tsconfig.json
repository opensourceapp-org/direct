{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM"],
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      "@direct/shared": ["packages/shared/src/index.ts"],
      "@direct/crypto": ["packages/crypto/src/index.ts"],
      "@direct/protocol": ["packages/protocol/src/index.ts"],
      "@direct/transport": ["packages/transport/src/index.ts"]
    }
  },
  "include": [
    "contracts/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "apps/mobile/src/**/*.ts",
    "apps/mobile/src/**/*.tsx",
    "apps/mobile/index.web.tsx",
    "apps/mobile/vite.config.ts"
  ]
}
