{
  "name": "direct",
  "private": true,
  "version": "0.1.0",
  "description": "DIRECT — decentralized peer-to-peer messaging. No middlemen. Just connection.",
  "scripts": {
    "test": "jest --colors --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm --filter @direct/mobile dev",
    "build": "pnpm --filter @direct/mobile build",
    "signaling": "node infrastructure/signaling/server.mjs",
    "server": "pnpm --filter @direct/server start",
    "postinstall": "node apps/server/node_modules/electron/install.js"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react-test-renderer": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  }
}
